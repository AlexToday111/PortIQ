SPRING_PROFILES_ACTIVE=local
INVEST_API_ENABLED=false
INVEST_API_TOKEN=
INVEST_METADATA_TTL=24h
INVEST_API_TIMEOUT=3s
INVEST_API_MAX_ATTEMPTS=3
INVEST_API_RETRY_BACKOFF=200ms
# Example universe only; no automatic refresh and no investment recommendation.
INVEST_TRACKED_TICKERS=SBER,LKOH,GAZP,ROSN,NVTK,GMKN,PLZL
INVEST_HISTORY_DAYS=365
INVEST_REFRESH_COOLDOWN=60s
FUNDAMENTALS_SNAPSHOT_TTL=24h
FUNDAMENTALS_REPORTING_MAX_AGE=548d
FUNDAMENTALS_REFRESH_COOLDOWN=60s
FUNDAMENTALS_REPORT_WINDOW_DAYS=180
DIVIDENDS_LOOKBACK_YEARS=3
DIVIDENDS_FORWARD_DAYS=365
DIVIDENDS_CACHE_TTL=24h
DIVIDENDS_REFRESH_COOLDOWN=60s
ANALYSIS_MINIMUM_PEERS=5
ANALYSIS_CLASSIFICATION_MAX_AGE=365d
# Experimental scoring assumptions; bump the configuration version when changing policy/weights/rules.
SCORING_MODEL_VERSION=fundamental-heuristic-1
SCORING_CONFIGURATION_VERSION=initial-1
SCORING_WEIGHT_Q=0.35
SCORING_WEIGHT_F=0.25
SCORING_WEIGHT_V=0.25
SCORING_WEIGHT_D=0.15
SCORING_MANDATORY_PILLARS=Q,F,V,D
SCORING_OBSERVATION_MAX_AGE=24h
SCORING_FINANCIAL_PERIOD_MAX_AGE=548d
SCORING_MINIMUM_DIVIDEND_DAYS=1095
SCORING_MINIMUM_DIVIDEND_YEARS=3
SCORING_EXTREME_YIELD=20
SCORING_HIGH_LEVERAGE=6
DB_HOST=localhost
DB_PORT=5432
DB_NAME=tradelab
DB_USERNAME=tradelab
# Non-sensitive example only. Replace in your untracked .env before use.
DB_PASSWORD=replace-with-a-local-password
# Optional full-stack HTTP host port (the container still listens on 8080).
# APP_PORT=8080

# Telegram is optional. Keep real bot credentials only in this untracked file.
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_ID=
